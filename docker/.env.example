# Gemini MCP — Docker self-hosting 설정 예시. `docker/docker.ps1 setup` / `docker/docker.sh setup` 이 .env 를 만들어 줍니다.

# Gemini API 키. 비워 두면 셸/사용자 환경 변수 GEMINI_API_KEY 를 사용합니다 (.env 에 평문 저장을 피하려면 비워 두세요).
GEMINI_API_KEY=

# 컨테이너와 공유할 호스트 폴더 (절대 경로). Claude 가 이 폴더 아래의 파일 경로를 넘기면 서버가 읽을 수 있고,
# 생성 파일은 <HOST_SHARE_DIR>/<OUTPUT_SUBDIR> 에 저장됩니다.
HOST_SHARE_DIR=C:\Users\me
OUTPUT_SUBDIR=gemini-mcp-output

# HTTPS(Caddy) 노출 주소/포트. 다른 PC 에서 접속하게 하려면 MCP_BIND=0.0.0.0.
# 같은 주소에서 MCP(/mcp)와 관리 대시보드(/)를 함께 제공합니다.
MCP_BIND=127.0.0.1
MCP_PORT=5100

# TLS 인증서에 넣을 이름 (쉼표 구분). 클라이언트가 접속에 쓰는 호스트명/IP 를 모두 적으세요.
#   예) 다른 PC 에서 접속: MCP_DOMAIN=localhost, 127.0.0.1, 192.168.0.10
MCP_DOMAIN=localhost, 127.0.0.1
# IP 주소로 접속하면 클라이언트가 SNI 를 보내지 않으므로 이 이름의 인증서를 씁니다. 다른 PC 가 IP 로 접속한다면 그 IP 로 바꾸세요.
MCP_DEFAULT_SNI=127.0.0.1
# internal   = Caddy 로컬 CA 로 자체 발급. 클라이언트가 루트 인증서를 신뢰해야 합니다 (docker.ps1 cert / docker.sh cert).
# 이메일 주소 = 공인 인증서(ACME, TLS-ALPN). 공개 DNS 도메인 + MCP_BIND=0.0.0.0 + MCP_PORT=443 필요.
MCP_TLS=internal
# 관리자가 준비한 인증서를 쓰려면 PEM 인증서(체인 포함)와 개인 키의 호스트 경로를 둘 다 지정하세요. 지정하면 MCP_TLS 는 무시됩니다.
# 컨테이너의 root(추가 권한 없음)가 읽을 수 있어야 하며, 인증서를 갱신한 뒤에는 restart 가 필요합니다.
#   예) MCP_TLS_CERT=/etc/letsencrypt/live/mcp.example.com/fullchain.pem
#       MCP_TLS_KEY=/etc/letsencrypt/live/mcp.example.com/privkey.pem
MCP_TLS_CERT=
MCP_TLS_KEY=

# MCP 클라이언트 인증은 대시보드에서 발급한 API 키(Authorization: Bearer gmcp_...)로 APISIX 게이트웨이가 처리합니다.
# 관리자 계정은 대시보드 최초 접속 시 대시보드 로그의 설정 코드로 만듭니다. 인증용 환경 변수는 없습니다.

# 생성 미디어(이미지·음성·영상) 저장소. 모든 결과물을 메타데이터(도구·모델·프롬프트·API 키)와 함께 S3 에 보관하고
# ResourceLink 로 돌려줍니다. 자동 삭제는 없으며 대시보드의 '생성 미디어' 화면에서 보고 지웁니다.
# S3_BUCKET 을 비워 두면 저장소 없이 실행되고, 이미지·음성·영상 도구만 오류를 반환합니다.
#   외부 S3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO 등): S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY 와
#     S3_ENDPOINT(AWS 면 비우고 S3_REGION 지정, 예: https://<계정>.r2.cloudflarestorage.com) 를 설정합니다.
#   내장 S3 (SeaweedFS 컨테이너, 선택): docker-compose.s3.yml 을 겹칩니다. 아래 COMPOSE_FILE 주석을 풀고
#     S3_SECRET_KEY 에 무작위 값을 넣으세요 (docker.ps1 setup -BundledS3 / docker.sh setup --bundled-s3 가 대신 해 줌).
#     S3_ENDPOINT·S3_REGION 은 무시되고, S3_BUCKET·S3_ACCESS_KEY 는 비우면 gemini-media·gemini-mcp 입니다.
#     버킷과 계정은 첫 실행 때 만들어지고 데이터는 s3-data 볼륨에 남습니다.
#COMPOSE_PATH_SEPARATOR=:
#COMPOSE_FILE=docker-compose.yml:docker-compose.s3.yml
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 버킷 안 키 접두사 (기본 gemini-mcp-media/). 버킷을 다른 용도와 함께 쓸 때 구분용.
S3_PREFIX=
# path-style 주소(https://host/bucket/key) 사용 여부. 비우면 S3_ENDPOINT 를 지정했을 때 true, AWS 기본은 false.
S3_PATH_STYLE=
# 미디어 다운로드 URL(/mcp/media/...)의 기준 주소. 비우면 요청의 Host 로 만듭니다. 예) https://mcp.example.com:5100
PUBLIC_URL=

# 로그·모니터링 지표 보존 기간 (일, Loki)
LOG_RETENTION_DAYS=7

# 허용할 브라우저 Origin (쉼표 구분). 기본은 localhost 만.
MCP_ALLOWED_ORIGINS=

# 모델은 환경 변수로 정하지 않습니다. MCP 도구 gemini_list_models / gemini_select_model 로 고르며,
# 선택은 출력 폴더의 .gemini-mcp-models.json 에 저장됩니다.

# 컨테이너 실행 UID/GID (Linux 호스트에서 공유 폴더 쓰기 권한용, 기본 1654)
DOCKER_UID=1654
DOCKER_GID=1654
