# Gemini MCP 앞단 리버스 프록시: TLS 종단 + zstd/gzip 응답 압축. 모든 요청을 APISIX 게이트웨이로 넘깁니다
# (APISIX 가 /mcp 는 API 키로 인증해 MCP 서버로, 나머지는 대시보드로 전달).
# 값은 docker-compose.yml 이 .env 에서 넘겨 줍니다.
#   MCP_DOMAIN  인증서를 발급할 이름 (쉼표 구분, 기본: localhost, 127.0.0.1)
#   MCP_TLS     internal = Caddy 로컬 CA 로 자체 발급 (기본)
#               <이메일>  = Let's Encrypt/ZeroSSL 공인 인증서 (공개 도메인 + 외부 443 포트 필요)
#               .env 에 MCP_TLS_CERT/MCP_TLS_KEY(관리자가 준비한 인증서)를 지정하면 docker-compose.yml 의 시작 명령이
#               이 값을 "/certs/cert.pem /certs/key.pem" 으로 바꿉니다 (Caddy 가 두 토큰으로 나눠 파일 인증서로 읽음).
#   MCP_DEFAULT_SNI  IP 주소로 접속해 SNI 가 없을 때 쓸 인증서 이름 (기본: 127.0.0.1)
#   MCP_PORT    HTTPS(TCP) + HTTP/3(UDP) 포트. 호스트와 같은 번호로 게시하므로 Alt-Svc 가 실제 포트를 광고합니다.
{
	# 관리 API 는 쓰지 않습니다 (설정 변경은 컨테이너 재시작으로).
	admin off
	https_port {$MCP_PORT}
	default_sni {$MCP_DEFAULT_SNI}
	# 로컬 CA 루트는 시작할 때마다 컨테이너 신뢰 저장소(tmpfs)에 설치됩니다. 클라이언트 쪽 신뢰는 `cert` 명령으로.

	servers {
		# HTTPS 포트로 평문 HTTP 가 들어오면 400("Client sent an HTTP request to an HTTPS server") 대신
		# 같은 포트의 https:// 로 308 리다이렉트합니다(메서드·본문 유지). 이후 TLS ALPN 으로 HTTP/2 를 쓰고,
		# Alt-Svc 로 광고한 HTTP/3(UDP) 로 자동 전환됩니다.
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

{$MCP_DOMAIN} {
	tls {$MCP_TLS}

	# zstd 를 우선, 지원하지 않는 클라이언트에는 gzip. SSE(text/event-stream) 도 이벤트마다 flush 됩니다.
	encode zstd gzip

	reverse_proxy apisix:9080 {
		# MCP SDK 는 SSE 응답에 "Content-Encoding: identity" 를 붙여 압축을 막습니다.
		# MCP 서버·APISIX 는 응답을 압축하지 않으므로 이 헤더를 지워 도구 결과(SSE)도 encode 가 압축하게 합니다.
		header_down -Content-Encoding
	}
}
