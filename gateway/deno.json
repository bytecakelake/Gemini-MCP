{
  "name": "@gemini-mcp/gateway",
  "version": "1.0.0",
  "exports": "./main.ts",
  "unstable": ["kv"],
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write main.ts",
    "reset-admin": "deno run --allow-env --allow-read --allow-write main.ts --reset-admin",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "check": "deno check main.ts && deno lint && deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": ["data/"]
  },
  "lint": {
    "exclude": ["data/"]
  }
}
